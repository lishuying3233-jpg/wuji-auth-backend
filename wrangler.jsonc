{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m7admin",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "m7-auth-db",
      "database_id": "88f4541d-3851-41f0-8cfb-563b7f7b55bd"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "35c1507b7199490e82c22129cda0a477"
    }
  ],
  "alias": {
    "body-parser": "./worker-shims/body-parser.ts"
  }
}
